@{
    Layout = null;
    ViewData["Title"] = "تایید خروج از سامانه — شرکت پالایش نفت آبادان";
}
<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>@ViewData["Title"]</title>
  <link rel="stylesheet" href="~/assets/css/identity.css" asp-append-version="true">
</head>
<body class="aorc-light-bg">

  <!-- Top Controls Bar -->
  <div class="aorc-top-controls-bar">
    <div class="aorc-live-clock-badge" id="aorcLiveClockBadge" aria-label="تاریخ و ساعت زنده">
      <div class="aorc-clock-icon">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <polyline points="12 6 12 12 16 14"/>
        </svg>
      </div>
      <span class="aorc-clock-date" id="aorcClockDate">--</span>
      <span class="aorc-clock-sep">•</span>
      <span class="aorc-clock-time" id="aorcClockTime">--:--</span>
    </div>

    <button type="button" class="aorc-theme-toggle" id="aorcThemeToggle" aria-label="تغییر تم شب و روز" title="تغییر تم">
      <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
      </svg>
      <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2"/>
        <path d="M12 20v2"/>
        <path d="m4.93 4.93 1.41 1.41"/>
        <path d="m17.66 17.66 1.41 1.41"/>
        <path d="M2 12h2"/>
        <path d="M20 12h2"/>
        <path d="m6.34 17.66-1.41 1.41"/>
        <path d="m19.07 4.93-1.41 1.41"/>
      </svg>
    </button>
  </div>

  <!-- Network Status Toast -->
  <div class="aorc-network-toast" id="aorcNetworkToast" role="status" aria-live="polite">
    <span class="aorc-network-toast-dot"></span>
    <span id="aorcNetworkToastText">ارتباط با شبکه سازمانی قطع گردید</span>
  </div>

  <!-- Ambient Particles -->
  <canvas id="aorcParticlesCanvas" class="aorc-particles-canvas"></canvas>

  <div class="aorc-ambient-glow aorc-ambient-glow-1"></div>
  <div class="aorc-ambient-glow aorc-ambient-glow-2"></div>

  <!-- Logout Card -->
  <main class="aorc-logout-card-clean">
    <div class="aorc-logo-wrap aorc-logo-wrap-logout" title="شرکت پالایش نفت آبادان">
      <img src="~/assets/img/refinery-logo-2.png" alt="شرکت پالایش نفت آبادان" class="aorc-logo-img">
    </div>

    <h1 class="aorc-logout-title-clean">تایید خروج از سامانه یکپارچه</h1>
    <p class="aorc-logout-desc-clean">
      کاربر گرامی؛ آیا از خروج خود اطمینان دارید؟ با خروج از سامانه احراز هویت متمرکز، نشست کاری شما در <strong>تمامی سامانه‌های متصل به SSO</strong> خاتمه خواهد یافت.
    </p>

    <!-- Logout Form -->
    <form id="aorcLogoutForm" asp-controller="Account" asp-action="LogOff" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
      @Html.AntiForgeryToken()
      <button type="submit" class="aorc-btn-logout-danger" id="aorcLogoutConfirmBtn">
        <span class="aorc-spinner"></span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
          <polyline points="16 17 21 12 16 7"/>
          <line x1="21" x2="9" y1="12" y2="12"/>
        </svg>
        <span class="aorc-btn-text">خروج از کلیه سامانه‌ها</span>
      </button>
      <a href="javascript:history.back()" class="aorc-btn-logout-cancel">انصراف و بازگشت</a>
    </form>
  </main>

  <!-- Scripts -->
  <script src="~/assets/js/identity.js" asp-append-version="true"></script>
</body>
</html>
